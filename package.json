{
  "name": "burning-man-camp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-camp-art.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-camp-art.mjs",
    "build": "next build",
    "vercel-build": "tsx --import ./scripts/lib/server-only-shim.mjs scripts/vercel-build.ts",
    "start": "next start",
    "lint": "biome check --error-on-warnings . && eslint --max-warnings 0 src",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "check:modules": "tsx --import ./scripts/lib/server-only-shim.mjs scripts/check-modules.ts",
    "db:up": "docker compose up -d",
    "db:generate": "tsx scripts/db-generate.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:studio": "drizzle-kit studio --config drizzle.base.config.ts",
    "seed": "tsx --import ./scripts/lib/server-only-shim.mjs seed/index.ts",
    "seed:demo": "pnpm seed && tsx --import ./scripts/lib/server-only-shim.mjs seed/demo.ts",
    "clean:dry-run": "tsx scripts/clean-dry-run.ts",
    "camp:setup": "tsx scripts/camp-setup.ts",
    "invite": "tsx --import ./scripts/lib/server-only-shim.mjs scripts/invite.ts",
    "module:flag": "tsx --import ./scripts/lib/server-only-shim.mjs scripts/module-flag.ts",
    "guardrails": "tsx scripts/ci/guardrails.ts",
    "test:coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "ai": "^7.0.153",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "next": "16.4.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "1.65.1",
    "@stryker-mutator/core": "10.1.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.3",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module"
}
