# Names only. Real values live in the camp password-manager vault, never in git.
# Copy to .env.local for local development (gitignored).

# Postgres. Local: docker compose (pnpm db:up) or any local Postgres 16+.
# Later: the Neon pooled / unpooled URLs.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/camp_dev
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/camp_dev
# Used by the DB test project (pnpm test:db). Must be a throwaway database.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/camp_test

# Better Auth. Generate a local secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email. "console" logs every email (incl. magic links) to the server console.
# "resend" arrives with the Resend account (not wired yet).
EMAIL_ADAPTER=console
EMAIL_FROM=
EMAIL_DAILY_CAP=95
RESEND_API_KEY=

# Files (Cloudflare R2), not used before B2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Jobs tick (B2), errors, uptime
# Vercel Cron bearer secret for /api/jobs/tick (daily 05:00 UTC = 07:00 camp time). Generate:
# openssl rand -base64 32. Unset = the tick route refuses every call.
CRON_SECRET=
SENTRY_DSN=
HEALTHCHECK_URL=

CAMP_TIMEZONE=America/Los_Angeles
# Comma-separated module ids to force off (previews/tests), e.g. kitchen,programming
MODULES_DISABLED=
SKIP_EXTERNAL_SERVICES=1

# Vercel AI Gateway key for "Ask the camp". Leave empty to use the free demo (keyword) router.
AI_GATEWAY_API_KEY=
# ASK_AI_MODEL=openai/gpt-5-nano
